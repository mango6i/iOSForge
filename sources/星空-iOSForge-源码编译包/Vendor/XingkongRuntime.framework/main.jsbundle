        "Can only send one message before mutual stared": "\u672a\u76f8\u4e92\u5173\u6ce8\u7684\u964c\u751f\u4eba\u9700\u8981\u5728\u5bf9\u65b9\u56de\u590d\u540e\u624d\u80fd\u518d\u6b21\u53d1\u6d88\u606f",
