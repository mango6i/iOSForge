        "Enter the password of this group": "\u8bf7\u8f93\u5165\u8fd9\u4e2a\u7fa4\u7ec4\u7684\u8fdb\u5165\u53e3\u4ee4",
        "Sending Failed": "\u53d1\u9001\u5931\u8d25",
        "Requesting Failed": "\u8bf7\u6c42\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5",
        "Connection Failed": "\u8fde\u63a5\u5931\u8d25\uff0c\u8bf7\u91cd\u8bd5",
        "You have login on other device": "\u60a8\u5df2\u5728\u5176\u4ed6\u8bbe\u5907\u4e0a\u767b\u5f55",
        "Friend from your phone contacts": "\u901a\u8baf\u5f55\u670b\u53cb",
        "Try again": "\u518d\u8bd5\u4e00\u6b21",
        "Change Failed": "\u4fee\u6539\u5931\u8d25",
        "When the story or message you sent contains pictures or videos, it will be automatically saved on the cloud storage of your account...": "\u5f53\u4f60\u7684\u5206\u4eab\u6216\u8005\u6d88\u606f\u4e2d\u6709\u56fe\u7247\u6216\u89c6\u9891\u65f6\uff0c\u7cfb\u7edf\u4f1a\u81ea\u52a8\u5c06\u5b83\u4eec\u4fdd\u5b58\u5728\u4f60\u8d26\u53f7\u4e0b\u7684\u4e91\u5b58\u50a8\u4e2d...",
        "This app has its own safe and private cloud storage. Not using other cloud storage to save your files.": "\u8fd9\u4e2aApp\u6709\u81ea\u5df1\u5b89\u5168\u53ef\u9760\u7684\u4e91\u5b58\u50a8\u7cfb\u7edf\uff0c\u4e0d\u4f1a\u4f7f\u7528\u5176\u4ed6\u7b2c\u4e09\u65b9\u7684\u4e91\u50a8\u5b58\u6765\u4fdd\u5b58\u4f60\u7684\u6587\u4ef6",
        Voice: "\u8bed\u97f3",
