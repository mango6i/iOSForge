        "Drift Reply": "\u56de\u590d",
        "Send drift or not?": "\u6f02\u6d41\u8fd9\u6761\u8bb0\u5f55\uff1f",
        "Post or not?": "\u662f\u5426\u53d1\u5e03\uff1f",
