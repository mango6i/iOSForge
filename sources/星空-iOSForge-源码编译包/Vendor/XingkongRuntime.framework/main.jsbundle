        "The user is your friend, are you sure to block it?": "\u5bf9\u65b9\u662f\u597d\u53cb\uff0c\u5c4f\u853d\u5c06\u4f1a\u89e3\u9664\u597d\u53cb\u5173\u7cfb\uff0c\u786e\u5b9a\u8981\u8fd9\u4e48\u505a\uff1f",
        "Are you sure to block this user from group?": "\u4f60\u786e\u5b9a\u8981\u5c06\u6b64\u7528\u6237\u4ece\u5f53\u524d\u7fa4\u4e2d\u62c9\u9ed1",
        "Not a friend": "\u4f60\u4e0d\u662f\u5bf9\u65b9\u7684\u597d\u53cb",
        "The friends you delete can't feel they've been deleted and you may still receive their comments on your shares": "\u4f60\u5220\u9664\u7684\u670b\u53cb\u65e0\u6cd5\u611f\u77e5\u5df2\u88ab\u4f60\u5220\u9664\u5e76\u4e14\u4f60\u4ecd\u7136\u53ef\u4ee5\u6536\u5230\u4ed6\u4eec\u5728\u4f60\u5206\u4eab\u4e2d\u7684\u8bc4\u8bba",
        "Are you sure to quit the group?": "\u4f60\u786e\u5b9a\u8981\u9000\u51fa\u8fd9\u4e2a\u7fa4?",
        "## quit the group": "## \u9000\u51fa\u4e86\u7fa4",
        "Change the group name": "\u4fee\u6539\u7fa4\u540d",
        "Only one chance share each day. Invite your friends could get another one": "\u9080\u8bf7\u670b\u53cb\u53ef\u4ee5\u83b7\u5f97\u6bcf\u5929\u989d\u5916\u4e00\u6b21\u7684chance\u5206\u4eab",
        "Is this user invited by you?": "\u8fd9\u4f4d\u7528\u6237\u662f\u4f60\u9080\u8bf7\u7684\u5417?",
        "The system will remind you to be your friends' inviters when they install the app and sign in.": "\u5f53\u4f60\u7684\u670b\u53cb\u5b89\u88c5\u548c\u767b\u5f55\u672capp\u540e\u7cfb\u7edf\u4f1a\u63d0\u793a\u4f60\u6210\u4e3a\u4ed6\u4eec\u7684\u9080\u8bf7\u4eba",
        "Send Request Failed": "\u53d1\u9001\u8bf7\u6c42\u5931\u8d25",
